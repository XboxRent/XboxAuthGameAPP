# Generate long random values; do not commit your real .env file.
API_KEY=replace-with-a-long-random-api-key
WORKER_KEY=replace-with-a-different-long-random-worker-key
# Supply only an OAuth token obtained through the official Xbox sign-in flow.
XREMOTE_OAUTH_TOKEN=
# Optional: exact serverId returned by getConsoles(); empty selects the first listed console.
XBOX_SERVER_ID=
PORT=3000